# Cache Control Headers for Bountywell
# Balanced caching approach - allow caching for performance but with reasonable expiration

# Cache HTML files for 1 hour
<FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=3600"
</FilesMatch>

# Cache CSS and JS files for 1 day
<FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=86400"
</FilesMatch>

# Cache manifest file for 1 hour
<FilesMatch "manifest\.json$">
    Header set Cache-Control "public, max-age=3600"
</FilesMatch>

# Cache images and icons for 1 year (they don't change often)
<FilesMatch "\.(png|jpg|jpeg|gif|ico|svg)$">
    Header set Cache-Control "public, max-age=31536000"
</FilesMatch>

# Internal documentation lives in the repo, not on the public site
<FilesMatch "\.md$">
    Require all denied
</FilesMatch>

# Source maps are build artifacts; they leak local build paths
<FilesMatch "\.map$">
    Require all denied
</FilesMatch>

# Server-side sources and build scripts are not part of the served app
<FilesMatch "^(server|db|api|generate-icons)\.js$">
    Require all denied
</FilesMatch>
<FilesMatch "^(package|package-lock)\.json$">
    Require all denied
</FilesMatch>

# Force HTTPS (if available)
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
